# Python virtual environment
venv/
env/
ENV/

# Large datasets (regenerable from source, too large for git)
dataset/
split/
real_world_dataset/

# PlantWild raw images (3.8 GB, regenerable from plantwild/readme.txt);
# only the small metadata files in plantwild/ are tracked
plantwild/images/
plantwild/split/
plantwild/split_smoke/
plantwild/_removed/

# Training run logs, regenerated by run_plantwild_training.ps1 / run_all_finetunes.ps1
logs/
logs_*.txt

# DINOv2 experiment: isolated torch venv + cached feature arrays (~950 MB)
dinov2_experiment/.venv/
dinov2_experiment/features/

# Website user uploads (regenerated per request)
website/static/uploads/

# Trained weights over 100 MB exceed GitHub's per-file hard limit. All four
# ResNet18 checkpoints are 128.4 MB each; the MobileNetV2 ones are 9.7 MB and
# are committed normally. Use Git LFS or an external release if the ResNet18
# weights need to be shared.
model/resnet18_plant_disease.keras
model/resnet18_improved.keras
model/resnet18_plantdoc.keras
model/resnet18_improved_plantdoc.keras
model/resnet18_plantdoc_checkpoints/
model/resnet18_improved_plantdoc_checkpoints/
model/plantwild_resnet18.keras
model/plantwild_simple_cnn.keras
model/simple_cnn_plant_disease.keras

# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local environment files
.env